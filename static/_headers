# Do not set Cache-Control on /*:
# 1. Cloudflare Pages defaults to "public, max-age=0, must-revalidate" with ETag
#    so HTML pages (/ , /posts/, /prompts/, etc.) always revalidate on navigation.
# 2. Cloudflare Pages appends matching headers across rules, so leaving Cache-Control
#    off /* allows path-specific rules below to set clean Cache-Control headers.
/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: "max-age=31536000; includeSubDomains; preload" env=HTTPS
  X-Frame-Options: deny
  Referrer-Policy: no-referrer
  Feature-Policy: microphone 'none'; payment 'none'; geolocation 'none'; midi 'none'; sync-xhr 'none'; camera 'none'; magnetometer 'none'; gyroscope 'none'
  X-XSS-Protection: 1; mode=block

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/fontawesome-6.5.2/*
  Cache-Control: public, max-age=31536000, immutable

/main.*.css
  Cache-Control: public, max-age=31536000, immutable

/style.*.css
  Cache-Control: public, max-age=31536000, immutable

/bundle.min.*.js
  Cache-Control: public, max-age=31536000, immutable
